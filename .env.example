# Environment Configuration

# Application Environment (local | demo | staging | production)
APP_ENV=local

# Set to true to enable deterministic demo adapters and scenario simulator
DEMO_MODE=true

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kirana_logistics?sslmode=disable

# Authentication Secret
AUTH_SECRET=changeme-super-secret-auth-key-min-32-chars

# Geospatial & Map Configuration
MAP_PROVIDER=maplibre
MAP_TILES_URL=https://demotiles.maplibre.org/style.json

# LLM / AI Configuration (Optional in Demo Mode)
AI_PROVIDER=mock
AI_API_KEY=

# Port Exposure
PORT=3000
